# Writes a binary file as a C array of bytes (read in chunks: CMake's regex
# engine chokes on megabyte strings):
#   cmake -DSRC=<file> -DOUT=<header> -DNAME=<symbol> -P EmbedBinary.cmake
file(SIZE "${SRC}" total)
file(WRITE "${OUT}" "// Generated by EmbedBinary.cmake from ${SRC}\nstatic const unsigned char ${NAME}[] = {\n")
set(offset 0)
while(offset LESS total)
    file(READ "${SRC}" hex HEX OFFSET ${offset} LIMIT 16384)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    file(APPEND "${OUT}" "${bytes}\n")
    math(EXPR offset "${offset} + 16384")
endwhile()
file(APPEND "${OUT}" "};\n")
