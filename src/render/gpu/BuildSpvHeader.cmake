# Compiles one compute shader to SPIR-V and writes it as a C array:
#   cmake -DGLSLC=<glslc> -DSRC=<shader.comp> -DOUT=<header> -DNAME=<symbol>
#         -DTARGET_ENV=vulkan1.2 -P BuildSpvHeader.cmake
# The array is named svms_spv_<NAME>.

get_filename_component(out_dir "${OUT}" DIRECTORY)
file(MAKE_DIRECTORY "${out_dir}")
execute_process(
    COMMAND "${GLSLC}" "--target-env=${TARGET_ENV}" "-fshader-stage=compute" "-O"
            "${SRC}" -o "${OUT}.spv"
    RESULT_VARIABLE result ERROR_VARIABLE log)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "glslc failed for ${SRC}:\n${log}")
endif()
file(READ "${OUT}.spv" hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])"
       "0x\\4\\3\\2\\1," words "${hex}")
file(WRITE "${OUT}" "// Generated by BuildSpvHeader.cmake from ${SRC}\nstatic const unsigned int svms_spv_${NAME}[] = {${words}};\n")
