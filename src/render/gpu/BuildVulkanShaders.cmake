# Compiles the GLSL of the GPU render stage (VoiceStageGLSL.h) to SPIR-V and
# writes the modules as C arrays:
#   cmake -DGLSLC=<glslc> -DSRC=<VoiceStageGLSL.h> -DWORK=<dir> -DOUT=<header>
#         -DGROUP=128 -DTILE=4 -P BuildVulkanShaders.cmake
# The GL source declares its parameters as plain uniforms; Vulkan has no default
# uniform block, so they become one push-constant block (a superset: each kernel
# reads only its own members).

file(READ "${SRC}" text)
string(FIND "${text}" "R\"GLSL(" begin)
string(FIND "${text}" ")GLSL\"" end)
if(begin LESS 0 OR end LESS begin)
    message(FATAL_ERROR "GLSL raw string not found in ${SRC}")
endif()
math(EXPR begin "${begin} + 7")
math(EXPR length "${end} - ${begin}")
string(SUBSTRING "${text}" ${begin} ${length} glsl)
string(REGEX REPLACE "uniform uint u[A-Za-z0-9_]+;" "" glsl "${glsl}")

set(prefix "#version 450
#if defined(SUBGROUP32)
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#endif
layout(push_constant) uniform Push {
    uint uCount; uint uFrames; uint uListBase; uint uGroupBase; uint uRetireBits;
    uint uGroups; uint uGroupFirst; uint uMixBase; uint uBase;
};
")
file(MAKE_DIRECTORY "${WORK}")
file(WRITE "${WORK}/VoiceStage.comp" "${prefix}${glsl}")

# name|define|subgroup
set(variants
    "voice|VOICE_CS|0" "voice_sg|VOICE_CS|1"
    "env|ENV_CS|0" "env_sg|ENV_CS|1"
    "reduce|REDUCE_CS|0" "scatter|SCATTER_CS|0" "env_scatter|ENV_SCATTER_CS|0")
set(header "// Generated by BuildVulkanShaders.cmake: SPIR-V of the GPU render stage.\n")
foreach(variant IN LISTS variants)
    string(REPLACE "|" ";" variant "${variant}")
    list(GET variant 0 name)
    list(GET variant 1 define)
    list(GET variant 2 subgroup)
    set(args "--target-env=vulkan1.1" "-fshader-stage=compute" "-O"
             "-DGROUP=${GROUP}" "-DTILE=${TILE}" "-D${define}=1")
    if(subgroup)
        list(APPEND args "-DSUBGROUP32=1")
    endif()
    execute_process(
        COMMAND "${GLSLC}" ${args} "${WORK}/VoiceStage.comp" -o "${WORK}/${name}.spv"
        RESULT_VARIABLE result ERROR_VARIABLE log)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "glslc failed for ${name}:\n${log}")
    endif()
    file(READ "${WORK}/${name}.spv" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])"
           "0x\\4\\3\\2\\1," words "${hex}")
    string(APPEND header "static const unsigned int svms_spv_${name}[] = {${words}};\n")
endforeach()
file(WRITE "${OUT}" "${header}")
